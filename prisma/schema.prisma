// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Run {
  id            Int     @id @default(autoincrement())
  runName       String
  time          Int     // Store time in seconds
  distance      Float   // Store distance in kilometers
  heartrate     Int     @default(60) // Store heartrate in bpm
  heartratezone String  @default("Zone 1")// Store heartrate zone 1,2,3,4,5
  createdAt DateTime @default(now())
}
